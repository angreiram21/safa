# Doxygen configuration for the SMASH afterburner analysis.

PROJECT_NAME = "SMASH Afterburner Analysis Modular"
PROJECT_BRIEF = "Modular HBT afterburner analysis"
OUTPUT_DIRECTORY = docs

OUTPUT_LANGUAGE = English
FULL_PATH_NAMES = YES
STRIP_FROM_PATH = .

INPUT = README.md src tests
FILE_PATTERNS = *.h *.cpp *.md
RECURSIVE = YES
USE_MDFILE_AS_MAINPAGE = README.md

EXTRACT_ALL = NO
EXTRACT_PRIVATE = YES
EXTRACT_STATIC = YES
HIDE_UNDOC_MEMBERS = NO
HIDE_UNDOC_CLASSES = NO

MARKDOWN_SUPPORT = YES
AUTOLINK_SUPPORT = YES
SOURCE_BROWSER = YES
INLINE_SOURCES = NO

QUIET = NO
WARNINGS = YES
WARN_IF_UNDOCUMENTED = YES
WARN_IF_DOC_ERROR = YES
WARN_AS_ERROR = NO
WARN_LOGFILE = docs/doxygen-warnings.log

GENERATE_HTML = YES
HTML_OUTPUT = doxygen
GENERATE_LATEX = NO
GENERATE_XML = NO
HAVE_DOT = YES
CLASS_GRAPH = YES
COLLABORATION_GRAPH = YES
INCLUDE_GRAPH = YES
INCLUDED_BY_GRAPH = YES
CALL_GRAPH = YES
CALLER_GRAPH = YES
DIRECTORY_GRAPH = YES
